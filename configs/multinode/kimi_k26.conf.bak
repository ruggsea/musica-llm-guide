# Kimi K2.6 -- 1.06T/32B MoE (384 experts), native INT4, 256K ctx, Modified MIT
# Same arch family as K2.5 (4N DP+EP precedent). Needs blobfile. vLLM>=0.25 per recipe.
MODEL_ID="moonshotai/Kimi-K2.6"
SERVED_NAME="kimi-k26"
MODE="dpep"
NODES=4
TP=4
DP_SIZE=16
DP_LOCAL=4
DTYPE="auto"
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTIL=0.85
EXTRA_ARGS="--enforce-eager --trust-remote-code"
TRUST_REMOTE_CODE=true
NEEDS_DEEPGEMM=false
VENV=/data/fs201045/rl41113/vllm-025-venv
GUIDE_HF_HOME=/data/fs201045/rl41113/hf-cache-guide
